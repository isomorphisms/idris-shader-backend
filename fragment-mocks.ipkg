package idris2-fragment-mock-backends
version = 0.1.0

sourcedir = "src"

depends = idris2, network

opts = "--inc chez"

modules = Backend.GLSLES.IR, Backend.GLSLES.Interface, Backend.GLSLES.Signature,
          Backend.GLSLES.Lower, Backend.FragmentMock.Targets,
          Backend.FragmentMock.Emit, Backend.FragmentMock.Codegen,
          Backend.FragmentMock.Main

main = Backend.FragmentMock.Main
executable = idris2-fragment-mocks
