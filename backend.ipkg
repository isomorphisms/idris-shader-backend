package idris2-glsles-backend
version = 0.2.0

sourcedir = "src"

depends = idris2, network

opts = "--inc chez"

modules = Backend.GLSLES.FloatSemantics, Backend.GLSLES.IR,
          Backend.GLSLES.Interface, Backend.GLSLES.Signature,
          Backend.GLSLES.Lower, Backend.GLSLES.Emit, Backend.GLSLES.Codegen,
          Backend.GLSLES.Main

main = Backend.GLSLES.Main
executable = idris2-glsles
