fragment(v_ndc : in F32x2, u_center : uniform F32x2, u_half_height : uniform F32, u_aspect : uniform F32, u_disc_center : uniform F32x2, u_disc_radius : uniform F32, u_resolution : uniform F32x2) -> F32x4
