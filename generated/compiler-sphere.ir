fragment(v_uv : in F32x2, u_time : uniform F32) -> F32x4
_idris_t0 : F32 = v_uv.x
_idris_t1 : F32 = (1.35 * _idris_t0)
_idris_t2 : F32 = v_uv.y
_idris_t3 : F32 = (1.35 * _idris_t2)
_idris_t4 : F32 = sin(u_time)
_idris_t5 : F32 = (0.35 * _idris_t4)
_idris_t6 : F32 = (_idris_t1 * _idris_t1)
_idris_t7 : F32 = (_idris_t3 * _idris_t3)
_idris_t8 : F32 = (_idris_t6 + _idris_t7)
_idris_t9 : F32 = (_idris_t5 * _idris_t5)
_idris_t10 : F32 = (_idris_t8 + _idris_t9)
_idris_t11 : F32 = (_idris_t10 - 1.0)
_idris_t12 : F32 = (2.0 * _idris_t1)
_idris_t13 : F32 = (2.0 * _idris_t3)
_idris_t14 : F32 = (2.0 * _idris_t5)
_idris_t15 : F32x3 = vec3(_idris_t12, _idris_t13, _idris_t14)
_idris_t16 : F32 = length(_idris_t15)
_idris_t17 : F32 = max(1e-5, _idris_t16)
_idris_t18 : F32 = (1.0 / _idris_t17)
_idris_t19 : F32x3 = (_idris_t18 * _idris_t15)
_idris_t20 : F32x3 = vec3(0.35, 0.55, 1.0)
_idris_t21 : F32x3 = normalize(_idris_t20)
_idris_t22 : F32 = dot(_idris_t19, _idris_t21)
_idris_t23 : Bool = (_idris_t22 > 0.0)
_idris_t24 : F32 = (_idris_t23 ? _idris_t22 : 0.0)
_idris_t25 : F32 = abs(_idris_t11)
_idris_t26 : F32 = (0.075 - _idris_t25)
_idris_t27 : F32 = (_idris_t26 / 0.075)
_idris_t28 : F32 = clamp(_idris_t27, 0.0, 1.0)
_idris_t29 : F32 = sin(u_time)
_idris_t30 : F32 = (0.12 * _idris_t29)
_idris_t31 : F32 = (0.88 + _idris_t30)
_idris_t32 : F32 = (0.75 * _idris_t24)
_idris_t33 : F32 = (0.25 + _idris_t32)
_idris_t34 : F32 = (_idris_t31 * _idris_t33)
_idris_t35 : F32 = (0.95 * _idris_t34)
_idris_t36 : F32 = mix(0.015, _idris_t35, _idris_t28)
_idris_t37 : F32 = (0.72 * _idris_t34)
_idris_t38 : F32 = mix(0.025, _idris_t37, _idris_t28)
_idris_t39 : F32 = (0.18 * _idris_t34)
_idris_t40 : F32 = mix(0.06, _idris_t39, _idris_t28)
_idris_t41 : F32x4 = vec4(_idris_t36, _idris_t38, _idris_t40, 1.0)
return _idris_t41

