package idris2-mali-mock-backend
version = 0.1.0

sourcedir = "src"

depends = idris2, network

opts = "--inc chez"

modules = Backend.GLSLES.IR, Backend.GLSLES.Interface, Backend.GLSLES.Signature,
          Backend.GLSLES.Lower, Backend.MaliMock.Emit, Backend.MaliMock.Codegen,
          Backend.MaliMock.Main

main = Backend.MaliMock.Main
executable = idris2-mali-mock
